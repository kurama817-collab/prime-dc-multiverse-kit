{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/canon.object.schema.json",
  "title": "Canon Object Schema (Codex Front-Matter)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "codex_id",
    "title",
    "universe",
    "timeline_scope",
    "status",
    "canon_lock"
  ],
  "properties": {
    "codex_id": {
      "type": "string",
      "description": "Stable ID used in cross-references and ingestion.",
      "pattern": "^CODEX\\.[A-Z0-9_\\-]+(\\.[A-Z0-9_\\-]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "universe": {
      "type": "string",
      "enum": ["prime-batman", "enlightened-dcu"]
    },
    "timeline_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^timeline-[a-z0-9\\-]+$"
      }
    },
    "status": {
      "type": "string",
      "enum": ["canon", "draft", "deprecated"]
    },
    "canon_lock": {
      "type": "boolean",
      "description": "If true, the object is considered canonical and should not drift without an explicit deprecation or new version."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CODEX\\.[A-Z0-9_\\-]+(\\.[A-Z0-9_\\-]+)*$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "canon_lock": { "const": true } },
        "required": ["canon_lock"]
      },
      "then": {
        "properties": { "status": { "const": "canon" } },
        "required": ["status"]
      }
    }
  ]
}
