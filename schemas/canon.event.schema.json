{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prime-dc.example/schemas/canon.event.schema.json",
  "title": "Canon Event",
  "description": "Schema for canon-governed narrative events in the DC Multiverse.",
  "type": "object",
  "required": [
    "id",
    "title",
    "summary",
    "timeline",
    "status",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$",
      "description": "Stable, lowercase identifier for the event."
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "timeline": {
      "type": "string",
      "enum": [
        "prime",
        "enlightened",
        "elseworld",
        "legacy"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "provisional",
        "retconned"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "year": {
      "type": "integer",
      "minimum": 1938
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "summary_locked": {
      "type": "boolean",
      "description": "When true, summary text is canon-locked."
    },
    "doctrine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requires_canon_vote": { "type": "boolean" },
        "cross_timeline": { "type": "boolean" },
        "studio_signoff": { "type": "boolean" }
      }
    }
  }
}
